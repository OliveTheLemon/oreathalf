# Combined .gitignore for root repository

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Compiled Sanity Studio
/dist

# Temporary Sanity runtime, generated by the CLI on every dev server start
/.sanity

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by testing tools
/coverage

# Next.js build output
/.next/
/out/

# Production build output
/build

# Vercel
.vercel

# Misc
.DS_Store
*.pem
.gitignore

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local env files
*.local
.env*.local

opengraph-image.png
.env*

# upload image folder
/uploads